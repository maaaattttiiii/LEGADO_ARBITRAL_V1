# Copiá este archivo a .env y completá los valores antes de `docker compose up`.
# .env está en .gitignore: nunca se versiona.

POSTGRES_DB=cabm
POSTGRES_USER=cabm
POSTGRES_PASSWORD=cambiame-por-una-clave-fuerte

# Obligatoria: firmar la cookie de sesión. Generala con:
#   openssl rand -hex 32
CABM_SECRET_KEY=cambiame-por-una-clave-aleatoria-de-64-hex

# 1 detrás de HTTPS (proxy/TLS). En pruebas locales por HTTP debe ser 0,
# porque con 1 el navegador no envía la cookie Secure.
CABM_HTTPS_ONLY=0

# Puerto publicado en el host.
CABM_PORT=8000
